# =============================================================================
# Local AI Email Security Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
#
# Gmail users: This agent requires an App Password, not your real Gmail
# password. App Passwords require 2-Factor Authentication to be enabled.
# See README.md → "Gmail App Password Setup" for step-by-step instructions.
# =============================================================================


# =============================================================================
# OLLAMA SETTINGS
# =============================================================================

# URL of your local Ollama instance.
# Default is localhost:11434 — change only if you run Ollama on a custom port
# or a remote machine.
OLLAMA_BASE_URL=http://localhost:11434

# The Ollama model to use for classification.
# Recommended: qwen2.5:1.5b (fast, runs on CPU, 8 GB RAM)
# Alternatives: qwen2.5:3b (better accuracy, needs ~6 GB VRAM)
#               mistral:7b (best accuracy, needs ~8 GB VRAM or strong CPU)
# Pull a model with: ollama pull qwen2.5:1.5b
OLLAMA_MODEL=qwen2.5:1.5b

# Timeout in seconds for each Ollama HTTP request.
# 30 seconds is generous for a 1.5b model. Increase if using a larger model.
OLLAMA_TIMEOUT=30

# Number of times to retry a failed Ollama request before giving up.
# Backoff: 2s, 4s, 8s between retries.
OLLAMA_MAX_RETRIES=3


# =============================================================================
# IMAP / EMAIL SETTINGS
# =============================================================================

# IMAP server hostname.
# Gmail: imap.gmail.com
# Outlook/Hotmail: imap-mail.outlook.com
# Yahoo: imap.mail.yahoo.com
IMAP_HOST=imap.gmail.com

# IMAP server port. 993 = IMAP over SSL (recommended). 143 = plain IMAP.
IMAP_PORT=993

# Your email address (Gmail, Outlook, etc.)
# Required — the agent will not start in --scan mode without this.
IMAP_USERNAME=your_email@gmail.com

# For Gmail: use an App Password generated at myaccount.google.com/apppasswords
# NOT your real Gmail password.
# For other providers: use your regular email password.
# Required — the agent will not start in --scan mode without this.
IMAP_PASSWORD=your_app_password_here

# Which mailbox folder to monitor.
# Usually INBOX. For Gmail labels use: [Gmail]/Spam, etc.
IMAP_MAILBOX=INBOX

# Set to true to mark emails as read after fetching.
# Set to false to leave emails as unread (recommended for initial testing).
# Valid values: true, false
IMAP_MARK_AS_READ=false


# =============================================================================
# PIPELINE SETTINGS
# =============================================================================

# Maximum number of characters to send from the email body to Ollama.
# Keeps prompt size within the model's context window (qwen2.5:1.5b ≈ 4k tokens).
# Increase carefully if using a model with a larger context window.
EMAIL_BODY_MAX_CHARS=1200

# Seconds between scans when running in --scan --watch mode.
# 60 = scan every minute. 300 = every 5 minutes.
SCAN_INTERVAL_SECONDS=60

# Maximum number of unread emails to process per scan cycle.
# Prevents the agent from being overwhelmed by a full inbox.
# The most recent N emails are selected.
MAX_EMAILS_PER_SCAN=10


# =============================================================================
# LOGGING
# =============================================================================

# Logging verbosity level.
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: very verbose — useful when troubleshooting Ollama responses
# INFO: normal operation messages (default)
# WARNING: only problems and retries
LOG_LEVEL=INFO
