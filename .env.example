# =============================================================================
# Local AI Email Security Agent — Environment Configuration
# =============================================================================
#
# HOW TO USE THIS FILE
# --------------------
# 1. Copy this file to .env:
#      Windows PowerShell:  Copy-Item .env.example .env
#      Linux / macOS:       cp .env.example .env
#
# 2. Fill in your Gmail address and App Password (see GMAIL SETUP below).
#
# 3. Pull a model with Ollama:
#      ollama pull qwen2.5:1.5b
#
# 4. Run the agent:
#      Without Docker:  python main.py --scan --watch
#      With Docker:     docker compose up
#
# NEVER commit your .env file to version control.
# It is already listed in .gitignore for your protection.
# =============================================================================


# =============================================================================
# OLLAMA SETTINGS
# =============================================================================
#
# IMPORTANT — Docker vs. local:
#
#   Running WITHOUT Docker (directly with Python):
#     OLLAMA_BASE_URL=http://localhost:11434
#
#   Running WITH Docker (docker compose up):
#     The docker-compose.yml automatically overrides this to:
#     OLLAMA_BASE_URL=http://host.docker.internal:11434
#     so you do NOT need to change this manually when switching to Docker.
#
# Ollama must be running on your host machine in both cases.
# Start it with: ollama serve  (or it starts automatically on most installs)
# -----------------------------------------------------------------------------

# URL of your local Ollama instance.
OLLAMA_BASE_URL=http://localhost:11434

# The Ollama model to use for email classification.
#
# HOW TO SWITCH MODELS:
#   1. Pull the model:   ollama pull qwen2.5:3b
#   2. Change this line: OLLAMA_MODEL=qwen2.5:3b
#   3. Restart the agent (or run: docker compose restart)
#   No code changes required.
#
# Recommended models (in order of speed vs. accuracy trade-off):
#   qwen2.5:1.5b   — Fastest. Runs on CPU. ~1 GB RAM. Good enough for most emails.
#   qwen2.5:3b     — Better accuracy. ~3 GB RAM. Still CPU-friendly.
#   qwen2.5:7b     — High accuracy. Needs GPU or strong CPU. ~5 GB RAM.
#   mistral:7b     — Very high accuracy. Needs ~8 GB VRAM or powerful CPU.
#   llama3.2:3b    — Good general-purpose alternative to qwen2.5:3b.
#
# Pull any model with:
#   ollama pull qwen2.5:1.5b
#   ollama pull qwen2.5:3b
#   ollama pull mistral:7b
OLLAMA_MODEL=qwen2.5:1.5b

# Timeout in seconds for each Ollama HTTP request.
# 30 seconds is generous for a 1.5b model running on CPU.
# Increase to 60-120 if using a larger model (7b+) on a slow machine.
OLLAMA_TIMEOUT=30

# Number of times to retry a failed Ollama request before giving up.
# Retries use exponential backoff: 2s, 4s, 8s between attempts.
# Set to 1 to fail fast (useful for debugging connectivity issues).
OLLAMA_MAX_RETRIES=3


# =============================================================================
# GMAIL SETUP
# =============================================================================
#
# Gmail requires an APP PASSWORD — your real Gmail password will NOT work.
# App Passwords are only available if you have 2-Factor Authentication enabled.
#
# STEP-BY-STEP GMAIL SETUP:
#   1. Go to your Google Account: https://myaccount.google.com
#   2. Click "Security" in the left sidebar.
#   3. Under "How you sign in to Google", enable "2-Step Verification" if not
#      already enabled. Follow the prompts.
#   4. After enabling 2FA, go to:
#      https://myaccount.google.com/apppasswords
#   5. Under "Select app", choose "Mail".
#   6. Under "Select device", choose "Windows Computer" (or your OS).
#   7. Click "Generate".
#   8. Copy the 16-character password shown (spaces are optional — include or omit).
#   9. Paste it into IMAP_PASSWORD below.
#
# Example:
#   IMAP_USERNAME=yourname@gmail.com
#   IMAP_PASSWORD=abcd efgh ijkl mnop
#
# ALSO ENABLE IMAP IN GMAIL:
#   1. Open Gmail → Settings (gear icon) → See all settings.
#   2. Click the "Forwarding and POP/IMAP" tab.
#   3. Under "IMAP access", select "Enable IMAP".
#   4. Click "Save Changes".
#
# ⚠️  App Passwords can be revoked at any time from your Google Account
#     without changing your real Gmail password.
# =============================================================================


# =============================================================================
# IMAP / EMAIL SETTINGS
# =============================================================================

# IMAP server hostname.
# Gmail:           imap.gmail.com        (use this for @gmail.com accounts)
# Outlook/Hotmail: imap-mail.outlook.com
# Yahoo:           imap.mail.yahoo.com
# Proton (Bridge): 127.0.0.1             (requires Proton Mail Bridge)
IMAP_HOST=imap.gmail.com

# IMAP server port.
# 993 = IMAP over SSL (recommended and required by Gmail)
# 143 = plain IMAP (not recommended — no encryption)
IMAP_PORT=993

# Your email address.
# This is the account the agent will monitor for new emails.
# Required — the agent will refuse to start in --scan mode without this.
IMAP_USERNAME=your_email@gmail.com

# App Password (Gmail) or regular password (other providers).
# For Gmail: use the 16-character App Password from myaccount.google.com/apppasswords
# For Outlook/Yahoo: use your regular account password.
# Required — the agent will refuse to start in --scan mode without this.
IMAP_PASSWORD=your_app_password_here

# Which mailbox folder to monitor.
# Usually INBOX. Gmail labels use special paths (e.g., [Gmail]/Spam).
IMAP_MAILBOX=INBOX

# Whether to mark emails as READ after fetching and classifying them.
# false (recommended for initial testing) — emails stay unread
# true — emails are marked as read in your Gmail inbox after processing
IMAP_MARK_AS_READ=false


# =============================================================================
# PIPELINE SETTINGS
# =============================================================================

# Maximum characters to send from the email body to the AI model.
# This controls the prompt size. Larger values = more context = slower responses.
# qwen2.5:1.5b has a ~4k token context window. 1200 characters ≈ 300-400 tokens.
# Increase to 2000-3000 if using qwen2.5:3b or larger models.
EMAIL_BODY_MAX_CHARS=1200

# Seconds between scans when running in --scan --watch (watch mode).
# 60  = scan every 1 minute (recommended for active monitoring)
# 300 = scan every 5 minutes (light monitoring)
# 3600 = scan every hour (passive monitoring)
# This setting has no effect in --scan (one-shot) mode.
SCAN_INTERVAL_SECONDS=60

# Maximum number of unread emails to process in a single scan cycle.
# Prevents the agent from being overwhelmed if your inbox has many unread emails.
# The most recent N emails (by date) are processed first.
# Increase if you want to process more emails per cycle.
MAX_EMAILS_PER_SCAN=10


# =============================================================================
# LOGGING
# =============================================================================

# Controls how much information the agent logs to the console.
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
#
# DEBUG    — Very verbose. Shows every Ollama request/response. Use for troubleshooting.
# INFO     — Normal operation. Shows scan results and key events. (recommended)
# WARNING  — Only shows problems and retries.
# ERROR    — Only shows errors.
# CRITICAL — Only shows critical failures.
LOG_LEVEL=INFO
