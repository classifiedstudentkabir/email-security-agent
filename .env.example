# =============================================================================
# Local AI Email Security Agent — Environment Configuration Template
# =============================================================================
#
# QUICK START DIRECTIONS:
# -----------------------
# 1. Create a copy of this file and rename it to exactly: .env
#    (Or just double-click 'Run.bat' which will create it automatically for you!)
#
# 2. Fill in your email account credentials under "IMAP / EMAIL SETTINGS" below.
#
# 3. Pull a local model using Ollama (e.g., in your command line run: ollama pull qwen2.5:1.5b)
#
# 4. Start the application:
#    - Easiest: Double-click 'Run.bat'
#    - Native Python: python main.py --scan --watch
#    - Docker directly: docker compose up
#
# IMPORTANT: Never commit or upload your actual '.env' file to GitHub or any
# public repository. It contains your private credentials.
# =============================================================================


# =============================================================================
# 🤖 OLLAMA SETTINGS (Local AI Engine)
# =============================================================================

# The network address where your local Ollama server is running.
#   - Running WITHOUT Docker: Leave as http://localhost:11434
#   - Running WITH Docker: Docker compose will automatically override this to
#     http://host.docker.internal:11434 so they can communicate.
# You do not need to change this variable when switching between modes.
OLLAMA_BASE_URL=http://localhost:11434

# The local AI model to use.
# Make sure you have pulled this model first by running: ollama pull <model_name>
# Recommended models:
#   - qwen2.5:1.5b   (Default. Ultra-fast, runs on CPU or GPU, uses ~1 GB RAM. Recommended!)
#   - qwen2.5:3b     (Slightly smarter, still CPU friendly, uses ~3 GB RAM)
#   - llama3.2:3b    (Good alternative, uses ~3 GB RAM)
#   - qwen2.5:7b     (Highly accurate, recommended if you have a strong GPU, uses ~5 GB RAM)
OLLAMA_MODEL=qwen2.5:1.5b

# How many seconds to wait for the local AI model to classify an email.
# Increase to 60 or 90 if running on older hardware or CPU-only without a GPU.
OLLAMA_TIMEOUT=30

# Number of times to retry a classification if Ollama fails to respond.
# Uses exponential backoff (waits 2s, then 4s, then 8s between attempts).
OLLAMA_MAX_RETRIES=3


# =============================================================================
# 📬 IMAP / EMAIL SETTINGS
# =============================================================================

# The secure incoming mail server address of your email provider.
#   - Gmail:           imap.gmail.com
#   - Outlook/Hotmail: imap-mail.outlook.com
#   - Yahoo:           imap.mail.yahoo.com
IMAP_HOST=imap.gmail.com

# Secure SSL port (993 is standard and required by almost all modern providers).
IMAP_PORT=993

# Your email address that the agent will scan.
IMAP_USERNAME=your_email@gmail.com

# Your login password.
# WARNING for Gmail: Do NOT use your regular Gmail password. You MUST enable
# 2-Factor Authentication on your Google Account and generate a 16-character
# "App Password" (e.g. abcd efgh ijkl mnop). See README.md for instructions.
IMAP_PASSWORD=your_app_password_here

# The email folder label to monitor. INBOX is standard.
IMAP_MAILBOX=INBOX

# Mark emails as READ after the AI classifies them?
#   - false (Recommended for testing) - Emails remain unread in your inbox.
#   - true - Emails are marked as read in your inbox after being analyzed.
IMAP_MARK_AS_READ=false


# =============================================================================
# ⚙️ PIPELINE SETTINGS
# =============================================================================

# Maximum number of characters from the email body sent to the AI model.
# Keeps the analysis fast and prevents memory limits. 1200 characters is about 300 words.
EMAIL_BODY_MAX_CHARS=1200

# How long to wait (in seconds) between scanning for new unread emails.
# e.g., 60 = scan every 1 minute. Active only when running in watch mode (--watch).
SCAN_INTERVAL_SECONDS=60

# Max number of unread emails to process in a single scan cycle.
# Prevents performance slowdowns if you have a large number of unread messages.
MAX_EMAILS_PER_SCAN=10


# =============================================================================
# 📝 LOGGING SETTINGS
# =============================================================================

# Level of detail printed in the console logs and written to files:
#   - DEBUG    (Very verbose, shows every raw network call and API response)
#   - INFO     (Normal level, showing scan starts and classification logs. Recommended)
#   - WARNING  (Only show warnings and errors)
#   - ERROR    (Only show critical connection issues and failures)
LOG_LEVEL=INFO
